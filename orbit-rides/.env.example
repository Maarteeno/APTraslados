# ── API ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Logs legibles. Requiere pino-pretty (devDependency): dejar en false dentro
# de contenedores, donde los logs deben salir en JSON para el colector.
LOG_PRETTY=true

# ── Postgres ──────────────────────────────────────────────────
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Ruteo ─────────────────────────────────────────────────────
# OSRM autohospedado: gratis, sin API key, sin cuota. Es el recomendado.
# Preparar los datos una vez:
#   docker compose --profile prepare up osrm-download osrm-build
OSRM_URL=http://localhost:5000
# Alternativa comercial. Si están los dos, gana OSRM.
MAPBOX_TOKEN=
ROUTING_TIMEOUT_MS=3500

# ── Firma de cotizaciones ─────────────────────────────────────
# Generá una propia: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUOTE_SIGNING_SECRET=cambiame_en_produccion_0123456789abcdef0123456789abcdef
QUOTE_TTL_SECONDS=120

# ── Auth ──────────────────────────────────────────────────────
# dev  = tokens locales firmados por el API (para probar sin Firebase)
# firebase = valida ID tokens de Firebase (produccion)
AUTH_MODE=dev
AUTH_DEV_SECRET=cambiame_tambien_0123456789abcdef0123456789abcdef
FIREBASE_PROJECT_ID=

# ── Dispatch ──────────────────────────────────────────────────
DISPATCH_OFFER_TTL_SECONDS=15
DISPATCH_MAX_WAVES=3
DISPATCH_WAVE_RADII_M=3000,5000,8000
DISPATCH_WAVE_SIZES=3,5,5
DRIVER_POSITION_TTL_SECONDS=30
