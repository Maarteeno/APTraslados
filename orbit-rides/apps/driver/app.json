{
  "expo": {
    "name": "Orbit Conductor",
    "slug": "orbit-driver",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "orbitdriver",
    "android": {
      "package": "com.orbitrides.driver",
      "versionCode": 2,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbit necesita tu ubicación para ofrecerte los viajes más cercanos."
        }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": true } }
      ]
    ],
    "newArchEnabled": true
  }
}
