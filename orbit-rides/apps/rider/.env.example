# URL del API.
#
#   Emulador de Android      http://10.0.2.2:8080
#   Celular en la misma WiFi http://192.168.x.x:8080
#
# El emulador es una VM: su localhost es él mismo, no tu PC. Android reserva
# 10.0.2.2 para apuntar al host.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Estilo de mapa de MapLibre. Sin API key.
#
# OJO: los proveedores de tiles libres son infraestructura comunitaria. Sirven
# para desarrollar y para escala chica; para producción conviene hospedar los
# propios o contratar un proveedor. Verificá los términos vigentes del que uses.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
